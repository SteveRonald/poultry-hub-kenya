DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=poultry marketplace
PORT=5000


# Environment Configuration for Poultry Hub Kenya

# JWT Secret Key (Generate a strong random key)
JWT_SECRET_KEY=your-jwt-secret-key-here

# API Keys (Get these from respective services)

OPENAI_API_KEY=your-openai-api-key-here
hugging_face_vision = your-hugging-face-api-key-here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Poultry Hub Kenya
ADMIN_EMAIL=your-email@gmail.com

# Security Settings
RATE_LIMIT_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT_MINUTES=5

# File Upload Settings
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp

# Base URL Configuration
BASE_URL=http://localhost/poultry-hub-kenya
