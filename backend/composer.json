{
    "name": "kukusoko/backend",
    "description": "KukuSoko Backend API",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "phpmailer/phpmailer": "^6.8",
        "paystack/paystack-php": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }, 
    "scripts": {
        "post-install-cmd": [
            "echo 'KukuSoko Backend installed successfully'"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}