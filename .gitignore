# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
node_modules/.vite
.vite
dist
dist-ssr
*.local

# Environment variables (CRITICAL - Never commit these!)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
.env.local
.env.production
.env.staging
.env.development
.env.test

# Security: Test files that may expose configuration
backend/test_*.php
backend/*_test.php

# Security sensitive files
backend/config/database.php.backup
backend/config/email_config.php.backup
backend/config/google_drive_tokens.json
backend/logs/
backend/backups/
backups/

# OAuth and API tokens
**/google_drive_tokens.json
**/oauth_tokens.json
**/api_tokens.json

# API Keys and tokens
**/tokens.json
**/credentials.json
**/*_key.txt
**/*_secret.txt
**/*_token.txt
**/*admin_token*
**/*session_token*
**/*auth_token*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vendor test files (PHP linting issues)
backend/vendor/**/test/**
backend/vendor/**/tests/**
backend/vendor/**/Test/**
backend/vendor/**/Tests/**

# Documentation README files (keep main README.md)
# Ignore README.md files in subdirectories (but not root README.md)
**/README.md
!/README.md

# Database documentation prompts
DATABASE_ER_DIAGRAM_PROMPT.md

# Railway deployment specific (keep the guide, exclude sensitive configs)
!RAILWAY_DEPLOYMENT_GUIDE.md
!railway.toml
railway.toml.example

# Paystack and payment configuration (keep setup guide, exclude sensitive data)
!PAYSTACK_LOCALHOST_SETUP.md
PAYSTACK_*_SECRETS.md
*PAYSTACK*_KEYS.md

# Local development setup guides with sensitive info
*LOCALHOST*_SECRETS.md
*SETUP*_SECRETS.md

# Temporary deployment files
deploy/
deployment/
*.tmp
temp/

# SSL certificates and keys
*.pem
*.key
*.crt
*.csr
ssl/

# Database dumps and exports
*.sql
*.sql.gz
*.dump
database_export_*
local_database.*

# Backup files with sensitive data
**/backup_*.sql
**/db_backup_*
**/*_backup.sql

# Configuration files with real credentials
backend/config/production_*.php
backend/config/live_*.php
backend/config/*_config.php
!backend/config/paystack_config.php

# Session and authentication files
**/sessions/
**/cache/
**/temp/
**/.sessions/

# Monitoring and analytics files
**/analytics_*
**/monitoring_*
**/metrics_*
