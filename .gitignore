# Environment variables (CRITICAL - Never commit these!)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
.env.local
.env.production
.env.staging
.env.development
.env.test
.envrc
*.env
*.env.*
*.env.local
*.env.backup
*.env.bak
*.env.save
**/.env
**/.env.*

# Security: Test files that may expose configuration
backend/test_*.php
backend/*_test.php
**/migration/

# Security sensitive files
backend/config/database.php.backup
backend/config/email_config.php.backup
backend/config/google_drive_tokens.json
backend/logs/
backend/backups/
backups/

# Runtime uploads (keep directory, ignore contents)
uploads/**
!uploads/.gitkeep

# OAuth and API tokens
**/google_drive_tokens.json
**/oauth_tokens.json
**/api_tokens.json

# API Keys and tokens
**/tokens.json
**/credentials.json
**/*_key.txt
**/*_secret.txt
**/*_token.txt
**/*admin_token*
**/*session_token*
**/*auth_token*
**/secrets.json
**/secret.json
**/*.secret
**/*.secrets

